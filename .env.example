# ==========================================================================
# Project Agent — environment template (safe for public repos)
# Copy to `.env` and fill in locally. Never commit a filled `.env`.
# ==========================================================================

# --- Application ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
TZ=Asia/Shanghai

# --- Database ---
DATABASE_URL=postgresql+psycopg://project_agent:change-me@localhost:5432/project_agent
POSTGRES_USER=project_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=project_agent
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
SCHEDULER_TIMEZONE=Asia/Shanghai

# --- Auth ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=720

# --- Web ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
CORS_ORIGINS=http://localhost:3000,http://localhost,http://localhost:8080
CORS_ALLOW_LAN=false
NEXT_PUBLIC_API_BASE_URL=

# --- LLM gateway (optional; stub used when empty) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_FAST=qwen-plus
LLM_MODEL_REASONING=deepseek-v3
LLM_TIMEOUT_SECONDS=300

# --- Project Assistant context ---
AGENT_RECENT_MESSAGES=200
AGENT_MAX_CONTEXT_TOKENS=1000000
AGENT_SUMMARY_TRIGGER_MESSAGES=40

# --- Seed users (make seed); set strong passwords before any shared deploy ---
SEED_ADMIN_PASSWORD=
SEED_EXECUTIVE_PASSWORD=
SEED_OWNER_PASSWORD=
SEED_MEMBER_PASSWORD=

# --- WeCom (optional) ---
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_REDIRECT_URL=
FRONTEND_BASE_URL=http://localhost:3000

# --- Notifications ---
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60
NOTIFICATION_DISPATCH_BATCH=50
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BACKOFF_SECONDS=60

# --- OA MySQL (read-only) + SSO (optional) ---
OA_MYSQL_HOST=
OA_MYSQL_PORT=3306
OA_MYSQL_USER=
OA_MYSQL_PASSWORD=
OA_MYSQL_DATABASE=
OA_MYSQL_ADMIN_TABLE=
OA_SSO_SECRET=
OA_SSO_MAX_AGE_SECONDS=300
OA_BASE_URL=

AI_RISK_EVIDENCE_MAX_AGE_DAYS=7
